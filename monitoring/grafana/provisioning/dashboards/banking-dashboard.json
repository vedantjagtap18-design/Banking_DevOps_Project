{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total Processed Transactions",
      "type": "stat",
      "targets": [
        { "expr": "sum(banking_transactions_total) or vector(0)", "refId": "A" }
      ],
      "options": { "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Live Checking Account Balance (USD)",
      "type": "gauge",
      "targets": [
        { "expr": "banking_account_balance_dollars", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": 10000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "green", "value": 3000 }
            ]
          }
        }
      }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Active Authenticated Sessions",
      "type": "stat",
      "targets": [
        { "expr": "banking_active_sessions", "refId": "A" }
      ],
      "options": { "colorMode": "value" }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Banking Service Health",
      "type": "stat",
      "targets": [
        { "expr": "up{job=\"banking-app\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "HTTP Traffic - Success vs 5xx Error Rate (Incident Detection)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(banking_http_requests_total{status_code=~\"2..\"}[1m]))",
          "legendFormat": "2xx Successful Requests/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(banking_http_requests_total{status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx Error Rate (Alert Trigger)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx Error Rate (Alert Trigger)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Fund Transfer Latency - 50th, 95th & 99th Percentile",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(banking_transfer_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 Median Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(banking_transfer_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency (Alert: >1s)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(banking_transfer_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Worst Case Latency",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Login Attempts - Success vs Failed (Security Monitor)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(banking_login_attempts_total{status=\"success\"}[1m]))",
          "legendFormat": "Successful Logins/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(banking_login_attempts_total{status=\"failed\"}[1m]))",
          "legendFormat": "Failed Logins/sec (Brute Force Alert)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Failed Logins/sec (Brute Force Alert)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Application Memory & CPU (Process Health)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "banking_app_process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS Memory (MB)",
          "refId": "A"
        },
        {
          "expr": "rate(banking_app_process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "CPU Usage (%)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["banking", "devops", "sre"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Apex Trust Banking - Reliability & Observability Dashboard",
  "uid": "banking-reliability-v2"
}
