{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total Processed Transactions",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(banking_transactions_total) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Live Checking Account Balance",
      "type": "gauge",
      "targets": [
        {
          "expr": "banking_account_balance_dollars",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": 10000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "green", "value": 3000 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Active Authenticated Sessions",
      "type": "stat",
      "targets": [
        {
          "expr": "banking_active_sessions",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Service Health Status",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"banking-app\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Fund Transfer Latency (95th Percentile)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(banking_transfer_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 latency (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "HTTP Traffic & 5xx Production Error Rate (Incident Detection)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(banking_http_requests_total{status_code=~\"2..\"}[1m]))",
          "legendFormat": "2xx Success Requests",
          "refId": "A"
        },
        {
          "expr": "sum(rate(banking_http_requests_total{status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx Outage Errors (Alert Trigger)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["banking", "devops", "kubernetes"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s"] },
  "timezone": "browser",
  "title": "Apex Trust Banking Reliability & Observability Dashboard",
  "uid": "banking-reliability-prod"
}
